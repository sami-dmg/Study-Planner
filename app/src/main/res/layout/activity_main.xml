<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F1F8E9"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📚 Study Planner"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#2E7D32"
            android:layout_gravity="center"
            android:paddingBottom="20dp"/>

        <EditText
            android:id="@+id/subjectCountInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Number of subjects"
            android:inputType="number"
            android:background="@android:drawable/editbox_background"
            android:padding="12dp"
            android:textColor="#000000"/>

        <Button
            android:id="@+id/generateTargets"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🎯 Set Target Hours"
            android:background="#388E3C"
            android:textColor="#FFFFFF"
            android:layout_marginTop="16dp"/>

        <LinearLayout
            android:id="@+id/targetLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="20dp"/>

        <Button
            android:id="@+id/proceedToActual"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="➡️ Enter Actual Hours"
            android:background="#1976D2"
            android:textColor="#FFFFFF"
            android:layout_marginTop="16dp"
            android:visibility="gone"/>

        <LinearLayout
            android:id="@+id/actualLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="20dp"
            android:visibility="gone"/>

        <Button
            android:id="@+id/showProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="✅ Show Progress"
            android:background="#F57C00"
            android:textColor="#FFFFFF"
            android:layout_marginTop="16dp"
            android:visibility="gone"/>

        <TextView
            android:id="@+id/resultText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="18sp"
            android:textColor="#D84315"
            android:paddingTop="20dp"
            android:paddingBottom="20dp"/>

    </LinearLayout>
</ScrollView>